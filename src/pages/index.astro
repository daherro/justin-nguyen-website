---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import LacquerCanvas from '../components/LacquerCanvas.astro';
import { projects } from '../data/projects';

const featured = projects.filter((p) => p.outcome && p.href);
const proof = [
  {
    org: 'Oliver Wyman',
    note: 'I lead strategy and product for enterprise clients, and I built The Hub, a 0-to-1 AI platform that shipped to five of them.',
  },
  {
    org: 'Microsoft',
    note: 'I ran a 10-person team through a Fortune 50 IT divestiture.',
  },
  {
    org: 'My own business',
    note: 'I co-founded Lot Armor, a parking lot striping company, ran it, and sold it.',
  },
];
---

<BaseLayout
  title="Justin Nguyễn · Strategist & Builder"
  preloadImage="/assets/lacquer-texture.webp"
>
  <div class="page">
    <LacquerCanvas />

    <div class="content">
      <Nav active={null} />

      <section class="hero">
        <div class="eyebrow hero-eyebrow" data-reveal>Strategist &amp; Builder</div>
        <h1 class="name" data-reveal style="--reveal-delay: 0.1s">Justin<br />Nguyễn</h1>
        <p class="tagline" data-reveal style="--reveal-delay: 0.22s">
          I structure ambiguous problems, build the thing, and ship it.
        </p>

        <div class="cta" data-reveal style="--reveal-delay: 0.3s">
          <a href="/projects" class="btn btn-primary">View projects</a>
          <a href="mailto:justintknguyen@gmail.com" class="btn">Get in touch</a>
        </div>

        <div class="status" data-reveal style="--reveal-delay: 0.38s">
          <span class="dot"></span>
          <span class="status-text">
            Currently exploring operator and product roles at growth-stage companies.
          </span>
        </div>
      </section>

      <section class="intro">
        <div class="rule-center" data-reveal></div>
        <div class="intro-grid">
          <div class="intro-copy">
            <p class="intro-lede" data-reveal style="--reveal-delay: 0.08s">
              I've spent the last six years moving between consulting and product work. Different
              problems, same instinct: give a tangled idea a shape, then go build it.
            </p>
            <dl class="proof">
              {proof.map((p, i) => (
                <div class="proof-row" data-reveal style={`--reveal-delay: ${0.14 + i * 0.06}s`}>
                  <dt>{p.org}</dt>
                  <dd>{p.note}</dd>
                </div>
              ))}
            </dl>
          </div>

          <div class="entries">
            <a href="/projects" class="entry" data-reveal style="--reveal-delay: 0.16s">
              <span class="num">01</span>
              <span class="entry-body">
                <span class="entry-title">Projects</span><br />
                <span class="entry-sub">Things I've built, shipped, and run.</span>
              </span>
              <span class="arrow">&rarr;</span>
            </a>
            <a href="/blog" class="entry" data-reveal style="--reveal-delay: 0.24s">
              <span class="num">02</span>
              <span class="entry-body">
                <span class="entry-title">Blog</span><br />
                <span class="entry-sub">Notes on strategy, technology, and ideas.</span>
              </span>
              <span class="arrow">&rarr;</span>
            </a>
          </div>
        </div>
      </section>

      <section class="work">
        <div class="work-head" data-reveal>
          <h2 class="eyebrow work-eyebrow">Featured work</h2>
          <a href="/projects" class="work-all">All projects <span class="arrow">&rarr;</span></a>
        </div>
        <div class="work-grid">
          {featured.map((p, i) => (
            <a
              href={p.href}
              target="_blank"
              rel="noopener noreferrer"
              class="card"
              data-reveal
              style={`--reveal-delay: ${0.08 + i * 0.08}s`}
            >
              <span class="card-meta">{p.category} · {p.year}</span>
              <span class="card-title">{p.title}</span>
              <span class="card-outcome">{p.outcome}</span>
              <span class="card-go" aria-hidden="true">&nearr;</span>
            </a>
          ))}
        </div>
      </section>

      <Footer />
    </div>
  </div>
</BaseLayout>

<style>
  .page { position: relative; min-height: 100vh; background: var(--bg-home); }
  .content { position: relative; z-index: 2; }

  .hero {
    /* the nav sits in flow above, so fill what is left of the first screen
       instead of a full extra viewport (that pushed the name too far down) */
    min-height: calc(100vh - 64px);
    min-height: calc(100svh - 64px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 32px var(--pad-x) 112px var(--pad-x);
  }
  .hero-eyebrow {
    margin-bottom: 26px;
    text-shadow: 0 1px 18px rgba(0, 0, 0, 0.7);
  }
  .name {
    font-family: var(--font-display);
    margin: 0;
    padding: 0.12em 0 0.16em 0;
    font-size: clamp(64px, 10vw, 144px);
    line-height: 1.08;
    font-weight: 600;
    background: linear-gradient(168deg, #fcf7e8 0%, #efe3c5 40%, #dcc489 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-shadow: 0 4px 50px rgba(0, 0, 0, 0.6);
  }
  .tagline {
    margin: 30px 0 0 0;
    font-size: clamp(20px, 2.6vw, 29px);
    line-height: 1.4;
    font-weight: 300;
    color: #e3dac4;
    max-width: 720px;
    text-shadow: 0 2px 26px rgba(0, 0, 0, 0.85);
  }
  .cta { margin-top: 38px; display: flex; flex-wrap: wrap; gap: 14px; }
  .status { margin-top: 36px; display: flex; align-items: center; gap: 12px; }
  .dot {
    width: 9px;
    height: 9px;
    flex: none;
    border-radius: 50%;
    background: var(--celadon-dot);
    box-shadow: 0 0 0 4px rgba(143, 176, 155, 0.18), 0 0 14px rgba(143, 176, 155, 0.7);
  }
  .status-text { font-size: 14.5px; color: #bdb4a1; text-shadow: 0 1px 14px rgba(0, 0, 0, 0.8); }

  .intro { max-width: var(--maxw); margin: 0 auto; padding: 0 var(--pad-x) 120px var(--pad-x); }
  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    padding-top: 64px;
    align-items: start;
  }
  .intro-copy { max-width: 560px; }
  .intro-lede {
    margin: 0;
    font-size: 19px;
    line-height: 1.68;
    color: var(--ink-softer);
    text-shadow: 0 1px 16px rgba(0, 0, 0, 0.7);
  }
  .proof { margin: 30px 0 0 0; }
  .proof-row {
    display: grid;
    grid-template-columns: 148px 1fr;
    gap: 20px;
    padding: 16px 0;
    border-top: 1px solid var(--rule-soft);
  }
  .proof dt {
    font-size: 12.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold-soft);
    padding-top: 0.3em;
  }
  .proof dd {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-softer);
    text-shadow: 0 1px 16px rgba(0, 0, 0, 0.7);
  }
  .entry {
    display: flex;
    align-items: baseline;
    gap: 26px;
    padding: 26px 0;
    border-top: 1px solid var(--rule);
    color: var(--ink);
    transition: color 0.2s ease;
  }
  .entry:hover { color: var(--gold); }
  .num { font-size: 14px; font-weight: 500; color: var(--muted-deep); font-variant-numeric: tabular-nums; }
  .entry-body { flex: 1; }
  .entry-title { font-family: var(--font-display); font-size: 40px; font-weight: 600; }
  .entry-sub { font-size: 15px; color: var(--muted); }
  .arrow {
    color: var(--celadon);
    font-size: 21px;
    align-self: center;
    transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .entry:hover .arrow { transform: translateX(6px); }

  .work { max-width: var(--maxw); margin: 0 auto; padding: 0 var(--pad-x) 120px var(--pad-x); }
  .work-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    padding-bottom: 22px;
  }
  .work-eyebrow { margin: 0; }
  .work-all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-size: 14.5px;
    color: var(--muted-link);
    transition: color 0.2s ease;
  }
  .work-all:hover { color: var(--gold); }
  .work-all .arrow { font-size: 17px; }
  .work-all:hover .arrow { transform: translateX(5px); }
  .work-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 28px 26px 30px 26px;
    border: 1px solid var(--rule);
    border-radius: 3px;
    background: rgba(12, 9, 7, 0.55);
    color: var(--ink);
    transition: color 0.22s ease, border-color 0.22s ease, background-color 0.22s ease;
  }
  .card:hover { color: var(--gold); border-color: rgba(227, 184, 100, 0.55); background-color: rgba(227, 184, 100, 0.05); }
  .card-meta { font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--celadon); }
  .card-title {
    margin-top: 16px;
    padding-right: 28px;
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 600;
    line-height: 1.1;
  }
  .card-outcome { margin-top: 12px; font-size: 15.5px; line-height: 1.55; color: var(--muted-link); }
  .card-go {
    position: absolute;
    top: 24px;
    right: 22px;
    font-size: 19px;
    color: var(--celadon);
    transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .card:hover .card-go { transform: translate(3px, -3px); }

  @media (max-width: 820px) {
    .intro-grid { grid-template-columns: 1fr; gap: 48px; }
    .intro-copy { max-width: none; }
    .work-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .hero { padding-bottom: 80px; }
    .proof-row { grid-template-columns: 1fr; gap: 6px; }
    .intro, .work { padding-bottom: 88px; }
  }
</style>
