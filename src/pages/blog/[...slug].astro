---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { readingMinutes, formatDate } from '../../utils/reading';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );
  return posts.map((post, i) => ({
    params: { slug: post.id },
    // pass the next (older) post for the "Next" link
    // the oldest post wraps around to the newest so no post is a dead end
    props: { post, next: posts[i + 1] ?? (posts.length > 1 ? posts[0] : null) },
  }));
}

const { post, next } = Astro.props;
const { Content } = await render(post);
const minutes = readingMinutes(post.body);
---

<BaseLayout title={`${post.data.title} · Justin Nguyễn`} description={post.data.summary}>
  <div class="page post-page">
    <!-- Set the reading theme before first paint: saved choice, else the OS preference. -->
    <script is:inline data-astro-rerun>
      (function () {
        var page = document.querySelector('.post-page');
        var theme = null;
        try { theme = localStorage.getItem('reading-theme'); } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        if (page) page.setAttribute('data-theme', theme);
      })();
    </script>
    <div class="ground" aria-hidden="true">
      <div class="base"></div>
      <div class="texture"></div>
      <div class="scrim"></div>
    </div>

    <div class="content">
      <Nav active="blog" variant="flow" />

      <main>
      <article class="article">
        <div class="toolbar" data-reveal>
          <a href="/blog" class="back"><span class="back-arrow">&larr;</span> All writing</a>
          <button type="button" class="theme-toggle" id="theme-toggle" aria-pressed="false">
            <span class="swatch" aria-hidden="true"></span>
            <span class="theme-label">Light mode</span>
          </button>
        </div>

        <div class="meta" data-reveal style="--reveal-delay: 0.06s">
          <span class="topic">{post.data.topic}</span>
          <span class="dotsep"></span>
          <span class="date">{formatDate(post.data.date)}</span>
          <span class="dotsep"></span>
          <span class="date">{minutes} min read</span>
        </div>

        <h1 class="title" data-reveal style="--reveal-delay: 0.12s">{post.data.title}</h1>
        <p class="standfirst" data-reveal style="--reveal-delay: 0.2s">{post.data.standfirst}</p>

        <div class="rule article-rule" data-reveal style="--reveal-delay: 0.28s"></div>

        <div class="post-body">
          <Content />
        </div>

        <div class="byline">
          <div class="avatar">N</div>
          <div>
            <div class="byname">Justin Nguyễn</div>
            <div class="byrole">Strategist &amp; Builder</div>
          </div>
        </div>
      </article>

      <section class="next-wrap outro">
        <p class="outro-copy">
          If this one stuck with you, or you think I got it wrong, I'd like to hear it.
        </p>
        <a href="mailto:justintknguyen@gmail.com" class="outro-link">Email me <span>&rarr;</span></a>
      </section>

      {
        next && (
          <section class="next-wrap">
            <a href={`/blog/${next.id}/`} class="next">
              <span>
                <span class="next-label">Next</span>
                <span class="next-title">{next.data.title}</span>
              </span>
              <span class="next-arrow">&rarr;</span>
            </a>
          </section>
        )
      }

      </main>

      <Footer marginTop="80px" />
    </div>
  </div>
</BaseLayout>

<style>
  .page { position: relative; min-height: 100vh; background: var(--bg); transition: background-color 0.3s ease; }

  /* ===== light reading theme (post pages only) ==========================
     Same type and the same gold / celadon hues, deepened so they hold
     contrast on paper. Everything below reads these tokens, including the
     nav and footer, so overriding them on .post-page is the whole theme. */
  .post-page[data-theme='light'] {
    --bg: #F5EFE1;
    --ink: #2A2118;
    --ink-bright: #1D160E;
    --ink-brightest: #1D160E;
    --ink-soft: #33291F;
    --ink-softer: #3B3126;
    --ink-nav: #2A2118;
    --muted: #645A4B;
    --muted-deep: #6A6050;
    --muted-nav: #554B3D;
    --muted-link: #4E4537;
    --gold: #865D10;
    --gold-soft: #8F6A1F;
    --celadon: #3B6350;
    --celadon-deep: #5F7A6A;
    --rule: rgba(134, 93, 16, 0.3);
    --rule-soft: rgba(134, 93, 16, 0.2);
    --rule-strong: rgba(134, 93, 16, 0.32);
    --code-bg: rgba(42, 33, 24, 0.06);
    color: var(--ink);
  }
  .post-page[data-theme='light'] .texture,
  .post-page[data-theme='light'] .scrim { display: none; }
  .ground { position: fixed; inset: 0; z-index: 0; pointer-events: none; }
  /* Stable large-viewport sizing so the iOS address bar does not rescale
     the fixed background on scroll. 100vh is the fallback. */
  .base,
  .texture,
  .scrim {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    height: 100lvh;
  }
  .base { background: var(--bg); }
  .texture {
    background: url('/assets/lacquer-texture.webp') center / cover no-repeat;
    opacity: 0.1;
  }
  .scrim {
    z-index: 1;
    background: linear-gradient(180deg, rgba(10, 7, 6, 0.86) 0%, rgba(10, 7, 6, 0.7) 30%, rgba(10, 7, 6, 0.78) 100%);
  }
  .content { position: relative; z-index: 2; }

  .article { max-width: 720px; margin: 0 auto; padding: 72px 32px 0 32px; }
  .toolbar { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 36px; }
  .back { display: inline-flex; align-items: center; gap: 9px; min-height: 44px; font-size: 14px; color: var(--celadon); transition: color 0.2s ease; }
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 44px;
    padding: 0;
    border: none;
    background: none;
    font: inherit;
    font-size: 14px;
    color: var(--muted-link);
    cursor: pointer;
    transition: color 0.2s ease;
  }
  .theme-toggle:hover { color: var(--gold); }
  /* half-filled disc: shows the theme you would switch to */
  .swatch {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1px solid currentColor;
    background: linear-gradient(90deg, currentColor 50%, transparent 50%);
  }
  .back:hover { color: var(--gold); }
  .back-arrow { font-size: 17px; transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1); }
  .back:hover .back-arrow { transform: translateX(-4px); }

  .meta { display: flex; gap: 14px; align-items: center; margin-bottom: 24px; flex-wrap: wrap; }
  .topic { font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--celadon); }
  .dotsep { width: 4px; height: 4px; border-radius: 50%; background: var(--celadon-deep); }
  .date { font-size: 13.5px; color: var(--muted-deep); font-variant-numeric: tabular-nums; }

  .title {
    font-family: var(--font-display);
    margin: 0;
    padding-bottom: 0.06em;
    font-size: clamp(40px, 6vw, 64px);
    line-height: 1.08;
    font-weight: 600;
    color: var(--ink-bright);
  }
  .standfirst { margin: 28px 0 0 0; font-size: 22px; line-height: 1.5; font-weight: 300; font-style: italic; color: var(--muted-link); }
  .article-rule { margin: 48px 0; }

  .byline { display: flex; align-items: center; gap: 16px; margin: 56px 0 0 0; padding-top: 32px; border-top: 1px solid var(--rule-soft); }
  .avatar {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #3a2a1c, #14100c);
    border: 1px solid rgba(227, 184, 100, 0.3);
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 22px;
    color: #E3B864;
  }
  .byname { font-size: 15px; color: var(--ink); }
  .byrole { font-size: 13px; color: var(--muted-deep); }

  .next-wrap { max-width: 720px; margin: 64px auto 0 auto; padding: 0 32px; }
  .outro { margin-top: 44px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 4px 24px; }
  .outro-copy { margin: 0; font-size: 16.5px; line-height: 1.55; color: var(--muted-link); max-width: 460px; }
  .outro-link { display: inline-flex; align-items: center; gap: 9px; min-height: 44px; font-size: 15px; color: var(--gold); transition: color 0.2s ease; }
  .outro-link:hover { color: var(--ink-bright); }
  .outro + .next-wrap { margin-top: 36px; }
  .next {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 30px 24px 30px 4px;
    border-top: 1px solid var(--rule-soft);
    color: var(--ink);
    transition: color 0.22s ease, padding-left 0.22s ease;
  }
  .next:hover { color: var(--gold); padding-left: 20px; }
  .next-label { display: block; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted-deep); margin-bottom: 8px; }
  .next-title { font-family: var(--font-display); font-size: 26px; font-weight: 600; }
  .next-arrow { font-size: 22px; color: var(--celadon); transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1); }
  .next:hover .next-arrow { transform: translateX(5px); }

  @media (max-width: 640px) {
    .article { padding: 40px 24px 0 24px; }
    .next-wrap { padding: 0 24px; }
  }
</style>

<script>
  // Light / dark reading toggle. The initial theme is set by the inline
  // script at the top of .post-page; this only handles the button.
  function initThemeToggle() {
    const page = document.querySelector<HTMLElement>('.post-page');
    const btn = document.getElementById('theme-toggle');
    if (!page || !btn || btn.dataset.bound) return;
    btn.dataset.bound = 'true';
    const label = btn.querySelector('.theme-label');
    const sync = () => {
      const light = page.dataset.theme === 'light';
      btn.setAttribute('aria-pressed', String(light));
      if (label) label.textContent = light ? 'Dark mode' : 'Light mode';
    };
    sync();
    btn.addEventListener('click', () => {
      const next = page.dataset.theme === 'light' ? 'dark' : 'light';
      page.dataset.theme = next;
      try {
        localStorage.setItem('reading-theme', next);
      } catch {}
      sync();
    });
  }
  // Run immediately as well: in production bundles the initial
  // astro:page-load can fire before this module's listener registers.
  initThemeToggle();
  document.addEventListener('astro:page-load', initThemeToggle);
</script>

<!-- Prose styling for markdown-rendered content (global, scoped under .post-body) -->
<style is:global>
  .post-body { font-size: 19px; line-height: 1.78; color: var(--ink-soft); font-weight: 400; }
  .post-body p { margin: 0 0 28px 0; }
  .post-body > p:first-of-type::first-letter {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 74px;
    line-height: 0.78;
    float: left;
    padding: 8px 14px 0 0;
    color: var(--gold);
  }
  .post-body a { color: var(--gold); border-bottom: 1px solid var(--rule-strong); }
  .post-body em { color: var(--ink); }
  .post-body strong { color: var(--ink-bright); font-weight: 600; }
  .post-body h2 {
    font-family: var(--font-display);
    font-size: 34px;
    font-weight: 600;
    line-height: 1.18;
    color: var(--ink-bright);
    margin: 46px 0 18px 0;
  }
  .post-body h3 {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 600;
    line-height: 1.2;
    color: var(--ink-bright);
    margin: 36px 0 14px 0;
  }
  .post-body blockquote {
    margin: 44px 0;
    padding: 0 0 0 28px;
    border-left: 2px solid var(--celadon-deep);
  }
  .post-body blockquote p {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 30px;
    line-height: 1.34;
    color: var(--celadon);
    margin: 0;
  }
  .post-body ul, .post-body ol { margin: 0 0 28px 0; padding-left: 22px; }
  .post-body li { margin-bottom: 10px; }
  .post-body code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.86em;
    background: var(--code-bg, rgba(227, 184, 100, 0.1));
    padding: 2px 6px;
    border-radius: 3px;
  }
  .post-body pre {
    background: var(--code-bg, rgba(0, 0, 0, 0.35));
    border: 1px solid var(--rule-soft);
    border-radius: 4px;
    padding: 20px;
    overflow-x: auto;
    margin: 0 0 28px 0;
  }
  .post-body pre code { background: none; padding: 0; }
  .post-body img { max-width: 100%; height: auto; border-radius: 3px; }
  .post-body hr { border: none; height: 1px; background: var(--rule); margin: 44px 0; }
</style>
