---
// Live raking-light son mai painting for the About hero.
// Ported from the Claude Design prototype (About.dc.html) to vanilla JS.
---

<canvas id="sonmai-canvas" aria-hidden="true"></canvas>
<!-- Without JS the canvas never paints, so show the texture as a plain image. -->
<noscript>
  <style>
    #sonmai-canvas {
      opacity: 1;
      background: url('/assets/sonmai-landscape.webp') center / cover no-repeat;
      filter: brightness(0.5);
    }
  </style>
</noscript>

<style>
  #sonmai-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    height: 100lvh;
    z-index: 0;
    display: block;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--canvas-fade, 1.4s) ease;
  }
  #sonmai-canvas.is-ready { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    #sonmai-canvas { transition: none; opacity: 1; }
  }
</style>

<script>
  import { prepareImage, type Prep, type PrepParams } from '../scripts/canvasPrep';

  const params: PrepParams = {
    src: '/assets/sonmai-landscape.webp',
    dim: [0.34, 0.82, 1.05, 0],
    bright: [1.95, 1.55, 1.14, 0],
    mask: { base: 0.7, warmGain: 0.75, floor: 0.07, gamma: 0.9 },
    glint: { minStep: 6, div: 240, minL: 0.4, minWarm: 0.1, speed: 0.5, speedRange: 1.6 },
  };

  // The pixel prep is expensive, so its result lives at module scope and
  // survives client-side navigations: revisiting the About page reuses it
  // instead of reprocessing the image.
  let prep: Prep | null = null;
  let prepPromise: Promise<Prep> | null = null;
  let cleanup: (() => void) | null = null;

  function loadPrep() {
    prepPromise ??= prepareImage(params).then((p) => (prep = p));
    return prepPromise;
  }

  function boot() {
    cleanup?.();
    cleanup = null;
    const cvs = document.getElementById('sonmai-canvas') as HTMLCanvasElement | null;
    if (!cvs) return;
    const ctx = cvs.getContext('2d')!;
    const reduced =
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let lx = window.innerWidth * 0.5;
    let ly = window.innerHeight * 0.45;
    let tx = lx;
    let ty = ly;
    let lastMove = -99999;
    let ready = false;
    let raf = 0;
    let alive = true;

    const tmp = document.createElement('canvas');
    const tctx = tmp.getContext('2d')!;
    let W = 0,
      H = 0,
      dpr = 1;
    let cover: { dx: number; dy: number; dw: number; dh: number; s: number };
    let start = performance.now();

    const offs: Array<() => void> = [];
    const on = (type: string, fn: EventListenerOrEventListenerObject) => {
      window.addEventListener(type, fn, { passive: true });
      offs.push(() => window.removeEventListener(type, fn));
    };
    cleanup = () => {
      alive = false;
      cancelAnimationFrame(raf);
      for (const off of offs) off();
    };

    on('pointermove', ((e: PointerEvent) => {
      tx = e.clientX;
      ty = e.clientY;
      lastMove = performance.now();
    }) as EventListener);
    on('touchmove', ((e: TouchEvent) => {
      if (e.touches && e.touches[0]) {
        tx = e.touches[0].clientX;
        ty = e.touches[0].clientY;
        lastMove = performance.now();
      }
    }) as EventListener);
    let rt: ReturnType<typeof setTimeout>;
    on('resize', () => {
      clearTimeout(rt);
      rt = setTimeout(layout, 160);
    });

    function layout() {
      if (!prep || !alive) return;
      // Read the canvas's stable CSS box (100lvh) rather than window.innerHeight,
      // which fluctuates as the iOS address bar shows/hides during scroll.
      const newW = cvs!.clientWidth;
      const newH = cvs!.clientHeight;
      // Skip no-op relayouts so scroll-driven resize events do not clear/rescale the canvas.
      if (newW === W && newH === H && cvs!.width) return;
      dpr = Math.min(window.devicePixelRatio || 1, 1.75);
      W = newW;
      H = newH;
      cvs!.width = W * dpr;
      cvs!.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      tmp.width = W * dpr;
      tmp.height = H * dpr;
      tctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const s = Math.max(W / prep.iw, H / prep.ih) * 1.06;
      const dw = prep.iw * s,
        dh = prep.ih * s;
      cover = { dx: (W - dw) / 2, dy: (H - dh) / 2, dw, dh, s };
    }

    function frame(now: number) {
      if (!alive) return;
      if (!ready || !prep) {
        raf = requestAnimationFrame(frame);
        return;
      }
      const t = (now - start) / 1000;
      const cv = cover;
      const dx = cv.dx,
        dy = cv.dy;

      // Blend toward the autonomous drift path over ~1.8s once the cursor has
      // been idle for 2.4s (a hard switch here used to make the light lurch).
      const idle = reduced ? 0 : Math.min(1, Math.max(0, (now - lastMove - 2400) / 1800));
      let ax = tx,
        ay = ty;
      if (idle > 0) {
        const wx = W * (0.5 + 0.3 * Math.cos(t * 0.22));
        const wy = H * (0.46 + 0.22 * Math.sin(t * 0.18));
        ax = tx + (wx - tx) * idle;
        ay = ty + (wy - ty) * idle;
      }
      const ease = 0.07 + 0.19 * (1 - idle);
      lx += (ax - lx) * ease;
      ly += (ay - ly) * ease;
      const R = Math.max(190, Math.min(W, H) * 0.24);
      const breath = reduced ? 1 : 0.88 + 0.12 * Math.sin(t * 0.85);

      ctx.globalCompositeOperation = 'source-over';
      ctx.clearRect(0, 0, W, H);
      ctx.drawImage(prep.baseDim, dx, dy, cv.dw, cv.dh);

      tctx.globalCompositeOperation = 'source-over';
      tctx.clearRect(0, 0, W, H);
      tctx.drawImage(prep.bright, dx, dy, cv.dw, cv.dh);
      tctx.globalCompositeOperation = 'destination-in';
      const grad = tctx.createRadialGradient(lx, ly, 0, lx, ly, R);
      grad.addColorStop(0, 'rgba(255,255,255,' + 1.0 * breath + ')');
      grad.addColorStop(0.4, 'rgba(255,255,255,' + 0.55 * breath + ')');
      grad.addColorStop(1, 'rgba(255,255,255,0)');
      tctx.fillStyle = grad;
      tctx.fillRect(0, 0, W, H);
      tctx.globalCompositeOperation = 'destination-in';
      tctx.drawImage(prep.lumAlpha, dx, dy, cv.dw, cv.dh);

      ctx.globalCompositeOperation = 'lighter';
      ctx.drawImage(tmp, 0, 0, W, H);

      // wet-sheen pass (proximity only)
      tctx.globalCompositeOperation = 'source-over';
      tctx.clearRect(0, 0, W, H);
      tctx.drawImage(prep.bright, dx, dy, cv.dw, cv.dh);
      tctx.globalCompositeOperation = 'destination-in';
      const sheen = tctx.createRadialGradient(lx, ly, 0, lx, ly, R * 0.82);
      sheen.addColorStop(0, 'rgba(255,255,255,' + 0.62 * breath + ')');
      sheen.addColorStop(1, 'rgba(255,255,255,0)');
      tctx.fillStyle = sheen;
      tctx.fillRect(0, 0, W, H);
      ctx.globalCompositeOperation = 'lighter';
      ctx.globalAlpha = 0.26;
      ctx.drawImage(tmp, 0, 0, W, H);
      ctx.globalAlpha = 1;

      const gr = R * 0.92;
      for (const gp of prep.glints) {
        const vx = dx + gp.ix * cv.s,
          vy = dy + gp.iy * cv.s;
        const ddx = lx - vx,
          ddy = ly - vy,
          dist = Math.sqrt(ddx * ddx + ddy * ddy);
        if (dist > gr) continue;
        const prox = 1 - dist / gr;
        const tw = reduced ? 1 : 0.45 + 0.55 * Math.sin(t * gp.sp + gp.ph);
        const a = prox * prox * tw * (0.7 + 0.5 * gp.l);
        if (a < 0.05) continue;
        const rad = 2 + prox * 9 * gp.l;
        const g2 = ctx.createRadialGradient(vx, vy, 0, vx, vy, rad);
        g2.addColorStop(0, 'rgba(255,238,176,' + Math.min(0.95, a * 1.3) + ')');
        g2.addColorStop(0.5, 'rgba(230,186,104,' + a * 0.6 + ')');
        g2.addColorStop(1, 'rgba(230,186,104,0)');
        ctx.fillStyle = g2;
        ctx.beginPath();
        ctx.arc(vx, vy, rad, 0, 6.2832);
        ctx.fill();
      }

      const halo = ctx.createRadialGradient(lx, ly, 0, lx, ly, R * 1.1);
      halo.addColorStop(0, 'rgba(224,180,104,0.1)');
      halo.addColorStop(1, 'rgba(224,180,104,0)');
      ctx.fillStyle = halo;
      ctx.fillRect(0, 0, W, H);
      ctx.globalCompositeOperation = 'source-over';

      raf = requestAnimationFrame(frame);
    }

    // Repeat visits have the prep cached, so use a shorter emergence fade.
    cvs.style.setProperty('--canvas-fade', prep ? '0.6s' : '1.4s');
    loadPrep()
      .then(() => {
        if (!alive) return;
        layout();
        ready = true;
        cvs.classList.add('is-ready');
      })
      .catch(() => {});
    start = performance.now();
    raf = requestAnimationFrame(frame);
  }

  // Boot immediately as well as on astro:page-load: in production bundles the
  // initial event can fire before this module's listener registers. boot()
  // cleans up any prior instance, so a double boot on first load is harmless.
  boot();
  document.addEventListener('astro:page-load', boot);
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = null;
  });
</script>
